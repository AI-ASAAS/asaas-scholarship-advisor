{"id": "ext_official_yemen_eligible", "input": {"request": {"nationality": "Yemen", "target_degree": "master", "major": "Computer Science", "target_countries": ["DE"], "use_cache": false}, "search_results": [{"url": "https://www.daad.de/en/stem-master", "title": "DAAD STEM Master Fellowship"}], "pages": {"https://www.daad.de/en/stem-master": "DAAD STEM Master Fellowship offers full tuition and monthly stipend for Computer Science master's students. Citizens of Yemen and all developing countries are eligible to apply. Application deadline is 2027-01-15 via the official portal."}}, "expect": {"equals": {"status": "complete", "results_count": 1, "first_url": "https://www.daad.de/en/stem-master", "first_eligibility": "yes", "first_eligible": true}}}
